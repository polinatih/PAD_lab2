# Скопируйте этот файл в .env:   copy .env.example .env   (Linux/macOS: cp .env.example .env)
# docker compose автоматически читает .env из корня проекта.

# ---------- Секреты (в реальном проекте обязательно поменять) ----------
JWT_SECRET=please-change-me-to-a-long-random-string-32
INTERNAL_API_KEY=please-change-me-internal-key
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

POSTGRES_PASSWORD=postgres
AUTH_DB_PASSWORD=auth_pass
RESTAURANT_DB_PASSWORD=restaurant_pass
ORDER_DB_PASSWORD=order_pass
PAYMENT_DB_PASSWORD=payment_pass
DELIVERY_DB_PASSWORD=delivery_pass
NOTIFICATION_DB_PASSWORD=notification_pass
REVIEW_DB_PASSWORD=review_pass

RABBITMQ_USER=food
RABBITMQ_PASSWORD=food_pass

# ---------- Прочее ----------
LOG_LEVEL=INFO
GATEWAY_PORT=8080
